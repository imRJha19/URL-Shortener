<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Login | URL Shortener</title>

  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #f9fafc;
      color: #111;
      transition: background 0.3s, color 0.3s;
    }

    body.dark-mode {
      background: #121212;
      color: #f0f0f0;
    }

    .container {
      max-width: 420px;
      margin: 80px auto;
      background: white;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      transition: background 0.3s;
    }

    body.dark-mode .container {
      background: #1e1e1e;
      box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    h1 {
      color: #0a2540;
      margin: 0;
    }

    body.dark-mode h1 {
      color: #ffd700;
    }

    .toggle {
      cursor: pointer;
      font-size: 22px;
      user-select: none;
    }

    p {
      margin-bottom: 25px;
      color: #555;
    }

    body.dark-mode p {
      color: #ccc;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    input {
      padding: 12px;
      border-radius: 6px;
      border: 1px solid #ccc;
      font-size: 15px;
    }

    body.dark-mode input {
      background: #2a2a2a;
      border: 1px solid #444;
      color: #fff;
    }

    button {
      padding: 12px;
      border: none;
      border-radius: 6px;
      background: #0a2540;
      color: white;
      font-size: 16px;
      cursor: pointer;
      transition: background 0.2s;
    }

    button:hover {
      background: #081c33;
    }

    .footer {
      margin-top: 20px;
      text-align: center;
      font-size: 14px;
    }

    .footer a {
      color: #d4af37;
      text-decoration: none;
      font-weight: 600;
    }
  </style>
</head>

<body>
  <div class="container">

    <div class="header">
      <h1>🔗 Login</h1>
      <span class="toggle" id="themeToggle">🌙</span>
    </div>

    <p>Welcome back! Login to manage your short URLs.</p>

    <form action="/users/login" method="POST">
      <input type="email" name="email" placeholder="Email address" required />
      <input type="password" name="password" placeholder="Password" required />
      <button type="submit">Login</button>
    </form>

    <div class="footer">
      Don’t have an account?
      <a href="/signup">Create one</a>
    </div>

  </div>

  <script>
    const toggle = document.getElementById("themeToggle");

    toggle.addEventListener("click", () => {
      document.body.classList.toggle("dark-mode");
      toggle.textContent =
        document.body.classList.contains("dark-mode") ? "☀️" : "🌙";
    });
  </script>
</body>
</html>
