<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>URL Shortener</title>
  <style>
    /* General Styles */
    .auth-btn {
  padding: 8px 14px;
  border-radius: 6px;
  text-decoration: none;
  font-weight: 600;
  border: none;
  cursor: pointer;
  background: #e5e5e5;
  color: #111;
}

.auth-btn.primary {
  background: #0a2540;
  color: white;
}

.auth-btn.logout {
  background: #d4af37;
  color: black;
}

.mode-btn {
  font-size: 20px;
  background: none;
  border: none;
  cursor: pointer;
}

body.dark-mode .auth-btn {
  background: #333;
  color: white;
}

body.dark-mode .auth-btn.primary {
  background: #ffd700;
  color: black;
}

    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #f9fafc;
      color: #111;
      transition: all 0.3s ease;
    }

    .container {
      max-width: 900px;
      margin: 50px auto;
      padding: 30px;
      background: white;
      border-radius: 10px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    h1 {
      color: #0a2540;
      margin-bottom: 10px;
    }

    .description {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 30px;
    }

    .description img {
      width: 100px;
      height: 100px;
    }

    .highlight {
      background: #fff8e1;
      border-left: 5px solid #d4af37;
      padding: 15px;
      margin-bottom: 25px;
      border-radius: 6px;
    }

    .highlight a {
      color: #0a2540;
      font-weight: 600;
      text-decoration: none;
    }

    form {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
    }

    input {
      flex: 1;
      padding: 12px;
      border-radius: 6px;
      border: 1px solid #ccc;
      font-size: 15px;
    }

    button {
      padding: 12px 22px;
      border: none;
      border-radius: 6px;
      background: #0a2540;
      color: white;
      font-size: 15px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    button:hover {
      background: #081c33;
    }

    /* Table Styles */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
      display: none; /* hidden initially */
    }

    th {
      background: #0a2540;
      color: white;
      padding: 12px;
      text-align: left;
    }

    td {
      padding: 10px;
      border-bottom: 1px solid #ddd;
    }

    tr:hover {
      background: #f1f5fb;
    }

    .short-link {
      color: #d4af37;
      font-weight: 600;
      text-decoration: none;
    }

    /* Dark Mode */
    body.dark-mode {
      background: #121212;
      color: #f0f0f0;
    }

    body.dark-mode .container {
      background: #1e1e1e;
      box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    }

    body.dark-mode .highlight {
      background: #333;
      border-left: 5px solid #ffd700;
    }

    body.dark-mode table th {
      background: #333;
      color: #ffd700;
    }

    body.dark-mode table td {
      border-bottom: 1px solid #444;
    }

    /* Footer */
    footer {
      margin-top: 30px;
      font-size: 14px;
      color: #555;
      text-align: center;
    }

    body.dark-mode footer {
      color: #ccc;
    }

    h1 {
    color: #0a2540; /* deep blue for light mode */
    margin-bottom: 20px;
  }

  body.dark-mode h1 {
    color: #ffd700; /* golden for dark mode */
  }

  button#darkModeToggle {
    margin-bottom: 20px;
    padding: 10px 15px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    background: #0a2540;
    color: white;
  }

  
  </style>
</head>
<body>
  <div class="container">
   
    
    <h1>🔗 URL Shortener</h1>
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">

  <div>
    <% if (userName) { %>
      <span style="font-weight:600; font-size:18px;">Hi, <%= userName %> 👋</span>
      <a href="/users/logout" class="auth-btn logout" style="margin-left:15px;">Logout</a>
    <% } else { %>
      <a href="/login" class="auth-btn" style="margin-right:10px;">Login</a>
      <a href="/signup" class="auth-btn primary">Signup</a>
    <% } %>
  </div>

  <button id="darkModeToggle" class="mode-btn">🌙</button>
</div>

<!-- Description Section -->
<div class="description">
  <p>
    Welcome to the URL Shortener! Generate short, shareable URLs easily.
    Track clicks and keep your links clean. 
  </p>
</div>


    <!-- Last Generated URL -->
    <% if (id) { %>
      <div class="highlight">
        Generated URL:
        <a href="/<%= id %>" target="_blank">http://localhost:8080/<%= id %></a>
      </div>
    <% } %>

    <!-- URL Form -->
    <form method="POST" action="/url">
      <input type="text" name="url" placeholder="https://example.com" required />
      <button type="submit">Generate</button>
    </form>

    <!-- Show History Button -->
    <% if (urls && urls.length > 0) { %>
      <button id="toggleHistory" style="margin-top:10px;">Show History</button>
    <% } %>

    <!-- Table -->
    <% if (urls && urls.length > 0) { %>
      <table id="historyTable">
        <thead>
          <tr>
            <th>#</th>
            <th>Short URL</th>
            <th>Original URL</th>
            <th>Clicks</th>
          </tr>
        </thead>
        <tbody>
          <% urls.forEach((u, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><a class="short-link" href="/<%= u.shortId %>" target="_blank"><%= u.shortId %></a></td>
              <td><%= u.redirectURL %></td>
              <td><%= u.visitHistory.length %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <!-- Footer -->
    <footer>Developed by Adarsh Jha</footer>
  </div>

  <!-- Scripts -->
  <script>
   
  const toggleBtn = document.getElementById("darkModeToggle");

  // Persist theme
  if (localStorage.getItem("theme") === "dark") {
    document.body.classList.add("dark-mode");
    toggleBtn.textContent = "☀️";
  }

  toggleBtn.addEventListener("click", () => {
    document.body.classList.toggle("dark-mode");
    const isDark = document.body.classList.contains("dark-mode");
    toggleBtn.textContent = isDark ? "☀️" : "🌙";
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });



    // Toggle history table
    const historyBtn = document.getElementById("toggleHistory");
    const historyTable = document.getElementById("historyTable");
    if (historyBtn) {
      historyBtn.addEventListener("click", () => {
        if (historyTable.style.display === "none" || historyTable.style.display === "") {
          historyTable.style.display = "table";
          historyBtn.innerText = "Hide History";
        } else {
          historyTable.style.display = "none";
          historyBtn.innerText = "Show History";
        }
      });
    }
  </script>
</body>
</html>
